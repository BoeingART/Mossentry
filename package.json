{
  "name": "mossentry",
  "productName": "Mossentry",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop manager for SSH hosts and access requests",
  "main": "desktop/main.cjs",
  "scripts": {
    "setup:backend": "python3.12 -m venv .venv && .venv/bin/python -m pip install -r backend/requirements.txt",
    "setup:test": ".venv/bin/python -m pip install -r backend/requirements-dev.txt",
    "build:icons": "electron desktop/generate-icons.cjs",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dev:ui": "vite --host 127.0.0.1",
    "check": "npm run build && npm run test:monitor && npm run test:desktop && node --check desktop/main.cjs && .venv/bin/python -m compileall -q backend/app && cd backend && ../.venv/bin/python -m unittest discover -s tests -v",
    "test:monitor": "node --experimental-strip-types --test frontend/tests/*.test.mjs",
    "build:runtime": "python scripts/build-runtime.py",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.4",
    "electron-builder": "26.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
