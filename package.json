{
  "name": "mossentry",
  "productName": "Mossentry",
  "version": "0.2.1",
  "private": true,
  "description": "Desktop manager for SSH hosts and access requests",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/rust-tool.cjs tauri dev",
    "dev": "node scripts/rust-tool.cjs tauri dev",
    "dev:ui": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:icons": "node scripts/rust-tool.cjs tauri icon icon.svg --output src-tauri/icons",
    "check": "npm run build && npm run test:monitor && npm run test:tools && npm run test:rust && npm run test:remote",
    "check:rust": "node scripts/rust-tool.cjs cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:rust": "node scripts/rust-tool.cjs cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:rust": "node scripts/rust-tool.cjs cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:monitor": "node --experimental-strip-types --test frontend/tests/*.test.mjs",
    "test:remote": "python3 -m unittest discover -s remote-tests -v",
    "dist": "node scripts/rust-tool.cjs tauri build",
    "dist:mac": "node scripts/rust-tool.cjs tauri build --bundles app,dmg",
    "dist:win": "node scripts/rust-tool.cjs tauri build --bundles nsis",
    "tauri": "node scripts/rust-tool.cjs tauri",
    "test:ssh": "python3 scripts/test-ssh.py",
    "clean": "node scripts/clean.cjs",
    "clean:all": "node scripts/clean.cjs --all",
    "test:tools": "node --test scripts/tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tauri-apps/api": "^2"
  },
  "type": "module"
}
